---
import Base from "../../layouts/Base.astro";
import Record from "../../components/Record.astro";
import Passage from "../../components/Passage.astro";
import {
  DISTRICT_SHORT,
  addressSearchUrl,
  formatDate,
  href,
  mapUrl,
  parcelFor,
  properties,
  scheduledFor,
  streetViewUrl,
} from "../../lib/data";

export function getStaticPaths() {
  return properties.map((property) => ({
    params: { slug: property.slug },
    props: { property },
  }));
}

const { property } = Astro.props;
const ordered = [...property.entries].sort((a, b) => b.meeting.date.localeCompare(a.meeting.date));
const pending = scheduledFor(property.sbl, property.address);
const parcel = parcelFor(property.sbl);
const first = ordered[ordered.length - 1];
const last = ordered[0];
---
<Base title={property.address}>
  <section style="padding: 2.5rem 0 1.25rem">
    <p class="eyebrow">Property record</p>
    <h1 style="font-size: clamp(1.9rem, 5vw, 2.8rem); margin: 0.4rem 0 0.6rem">{property.address}</h1>
    <div class="record__meta" style="font-size:.8rem">
      {property.sbl && <span>SBL {property.sbl}</span>}
      {property.ward !== null && <span>Ward {property.ward}</span>}
      {property.districts.map((d) => <span>{DISTRICT_SHORT[d] ?? d}</span>)}
      <span>
        {ordered.length} {ordered.length === 1 ? "appearance" : "appearances"}
        {first !== last && ` · ${first.meeting.date} to ${last.meeting.date}`}
      </span>
    </div>
    <p class="lookaway">
      {parcel ? (
        <Fragment>
          <a class="source-link source-link--plain" href={streetViewUrl(parcel.lat, parcel.lon)}>Street view</a>
          <a class="source-link source-link--plain" href={mapUrl(parcel.lat, parcel.lon)}>Map</a>
        </Fragment>
      ) : (
        <a class="source-link source-link--plain" href={addressSearchUrl(property.address)}>Find on a map</a>
      )}
      <span class="mono">Opens Google Maps. No imagery is hosted here.</span>
    </p>

    {property.addresses.length > 1 && (
      <p class="mono" style="color: var(--ink-3); margin:.5rem 0 0">
        Also minuted as {property.addresses.slice(1).join(", ")}
      </p>
    )}
  </section>

  {pending.length > 0 && (
    <div class="panel" style="border-left:3px solid var(--frame); margin-bottom:1.5rem">
      <p class="eyebrow" style="margin-bottom:.4rem">Due to be heard</p>
      {pending.map(({ agenda, item }) => (
        <p style="margin:0 0 .4rem">
          <a href={href("/upcoming/")}>{formatDate(agenda.date)}</a>, item {item.number} — {item.title}
          {agenda.comment_deadline && (
            <span style="color:var(--ink-2)"> Written comment closes {agenda.comment_deadline}.</span>
          )}
        </p>
      ))}
    </div>
  )}

  <ol class="docket">
    {ordered.map((entry) => <Record entry={entry} showProperty={false} />)}
  </ol>

  <section style="padding-top:2rem">
    <h2 class="eyebrow">What the commission said</h2>
    {ordered.map((entry) => (
      <div style="padding:.9rem 0; border-top:1px solid var(--rule-soft)">
        <p class="mono" style="margin:0 0 .5rem; color:var(--ink-3)">
          <a href={href(`/meetings/${entry.meeting.date}/`)}>{entry.meeting.date}</a> · item {entry.number}
          <a class="source-link" style="margin-left:.5rem" href={entry.meeting.source_url}>Minutes</a>
        </p>
        <Passage text={entry.discussion} tight />
        {entry.decisions.map((decision) => (
          <blockquote class="quote">
            <strong class="mono">{decision.board}</strong>
            <Passage text={decision.text} tight />
          </blockquote>
        ))}
      </div>
    ))}
  </section>
</Base>
