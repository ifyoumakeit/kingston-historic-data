---
import "../styles/global.css";
import { href, localPath, stats } from "../lib/data";

interface Props { title: string; description?: string; }
const { title, description = "Every decision the Kingston Historic Landmarks Preservation Commission has recorded since 2020, indexed by property, work, and outcome." } = Astro.props;
const path = localPath(Astro.url.pathname);
const nav = [
  { href: "/", label: "Docket" },
  { href: "/upcoming/", label: "Upcoming" },
  { href: "/meetings/", label: "Meetings" },
  { href: "/properties/", label: "Properties" },
  { href: "/map/", label: "Map" },
  { href: "/people/", label: "Commissioners" },
  { href: "/about/", label: "About" },
];
const current = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Kingston HLPC Docket</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead">
      <div class="shell masthead__inner">
        <a class="masthead__mark" href={href("/")}>Kingston <span>HLPC</span> Docket</a>
        <span class="mono" style="color: var(--ink-3)">
          {stats.firstDate?.slice(0, 4)}–{stats.lastDate?.slice(0, 4)} · {stats.meetings} meetings · {stats.items} items
        </span>
        <nav>
          {nav.map((item) => (
            <a href={href(item.href)} aria-current={current(item.href) ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main class="shell" id="main"><slot /></main>

    <footer class="footer">
      <div class="shell">
        <p style="margin:0 0 .4rem">
          Built from the minutes the City of Kingston publishes at{" "}
          <a href="https://kingston-ny.gov/Agendas">kingston-ny.gov/Agendas</a>.
          Every decision here links to the PDF it was read from.
        </p>
        <p class="mono" style="margin:0; color: var(--ink-3)">
          Unofficial. The signed minutes are the record; this is an index of them.
        </p>
      </div>
    </footer>
    <script>
    // Progressive enhancement: the triggers are links to the meeting page and
    // keep working if this never runs.
    let opener: HTMLElement | null = null;

    for (const trigger of document.querySelectorAll<HTMLAnchorElement>("a.js-open")) {
      trigger.addEventListener("click", (event) => {
        const sheet = document.getElementById(trigger.dataset.dialog!) as HTMLDialogElement | null;
        if (!sheet?.showModal) return;
        event.preventDefault();
        // Remember the opener explicitly: a mouse click does not reliably
        // leave focus on the anchor, so the platform has nothing to restore.
        opener = trigger;
        sheet.showModal();
      });
    }
    for (const sheet of document.querySelectorAll<HTMLDialogElement>("dialog.sheet")) {
      sheet.querySelector("[data-close]")?.addEventListener("click", () => sheet.close());
      // Clicking the backdrop closes it; clicks inside the panel must not.
      sheet.addEventListener("click", (event) => {
        if (event.target === sheet) sheet.close();
      });
      // Covers Escape as well as the close button and backdrop.
      sheet.addEventListener("close", () => {
        opener?.focus();
        opener = null;
      });
    }
    </script>
  </body>
</html>
